# ------------------------------
# KGM Cables App Configuration
# ------------------------------

# Your Twilio Account SID
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN="your_auth_token"

# Your Twilio phone number (for SMS)
TWILIO_PHONE_NUMBER="+15551234567"

# Your WhatsApp Sender Number
WHATSAPP_SENDER_NUMBER="+15551234567"

# ------------------------------
# Login Page Configuration
# ------------------------------

# Set to "true" to enable password protection, or "false" to disable it.
PASSWORD_PROTECT="true"

# The password used to access the site when protection is enabled.
APP_PASSWORD="your_secret_password_here"

# A random, secret string required by Flask to securely manage user sessions.
# Generate one with: python -c 'import secrets; print(secrets.token_hex(16))'
SECRET_KEY="your_super_secret_key_here"